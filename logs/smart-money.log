    SELECT
        t.category,
        COUNT(*) 
    FROM
        transactions t 
    WHERE
        EXTRACT(YEAR FROM t.created_at) = ? 
        AND EXTRACT(MONTH FROM t.created_at) =? 
    GROUP BY
        t.category
