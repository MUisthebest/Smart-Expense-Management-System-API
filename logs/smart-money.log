    COALESCE(SUM(CASE 
        WHEN t.type = 'EXPENSE' 
            THEN t.amount 
        ELSE 0 
END), 0) AS total_expense 
FROM
    transactions t 
WHERE
    t.user_id = CAST(? AS uuid) 
