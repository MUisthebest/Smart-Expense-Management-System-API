            THEN t.amount 
        ELSE 0 
END), 0) AS total_expense 
FROM
    transactions t 
WHERE
    t.user_id = CAST(? AS uuid) 
    AND EXTRACT(YEAR FROM t.date) = ? 
    AND EXTRACT(MONTH FROM t.date) = ? 
GROUP BY
    day_of_month 
