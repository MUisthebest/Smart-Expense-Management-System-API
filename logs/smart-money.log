        unnest(ARRAY['INCOME', 'EXPENSE']) AS type ), stats AS (     SELECT
        t.type,         ((EXTRACT(DAY FROM t.date)::int - 1) / 7) + 1 AS week_of_month,         COALESCE(SUM(t.amount), 0) AS total_amount     FROM transactions t     
    WHERE
        t.user_id = CAST(? AS uuid)       
        AND EXTRACT(MONTH FROM t.date) = ?       
        AND EXTRACT(YEAR FROM t.date) = ?     
    GROUP BY
        t.type, week_of_month ) SELECT
        types.type,
        weeks.week_of_month,
        COALESCE(stats.total_amount, 0) AS total_amount 
    FROM
        weeks 
    CROSS JOIN
        types 
    LEFT JOIN
        stats   
            ON stats.week_of_month = weeks.week_of_month  
            AND stats.type = types.type 
    ORDER BY
        weeks.week_of_month,
        types.type 
