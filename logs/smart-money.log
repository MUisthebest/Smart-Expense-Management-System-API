    WITH weeks AS (     SELECT
        generate_series(1, 5) AS week_of_month ), types AS (     SELECT
        unnest(ARRAY['INCOME', 'EXPENSE']) AS type ), stats AS (     SELECT
        t.type,         ((EXTRACT(DAY FROM t.created_at)::int - 1) / 7) + 1 AS week_of_month,         COUNT(*) AS total_rows     FROM transactions t     
    WHERE
        EXTRACT(MONTH FROM t.created_at) = ?       
        AND EXTRACT(YEAR FROM t.created_at) = ?     
    GROUP BY
        t.type, week_of_month ) SELECT
        types.type,
        weeks.week_of_month,
        COALESCE(stats.total_rows, 0) AS total_rows 
    FROM
        weeks 
    CROSS JOIN
        types 
    LEFT JOIN
        stats   
            ON stats.week_of_month = weeks.week_of_month  
            AND stats.type = types.type 
    ORDER BY
        weeks.week_of_month,
        types.type 
