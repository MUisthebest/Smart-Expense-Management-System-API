        t.type,         ((EXTRACT(DAY FROM t.date)::int - 1) / 7) + 1 AS week_of_month,         COUNT(*) AS total_rows     FROM transactions t     
    WHERE
        t.user_id = CAST(? AS uuid)       
        AND EXTRACT(MONTH FROM t.date) = ?       
        AND EXTRACT(YEAR FROM t.date) = ?     
    GROUP BY
        t.type, week_of_month ) SELECT
        types.type,
        weeks.week_of_month,
        COALESCE(stats.total_rows, 0) AS total_rows 
