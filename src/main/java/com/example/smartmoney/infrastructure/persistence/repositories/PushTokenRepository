package com.example.smartmoney.infrastructure.repositories;

import com.example.smartmoney.domain.models.notification.PushToken;
import com.example.smartmoney.infrastructure.persistence.repositories.JpaPushTokenRepository;
import java.util.Optional;
import java.util.List;

public interface PushTokenRepository extends JpaPushTokenRepository {

    Optional<PushToken> findByPushToken(String pushToken) {
        Optional<PushTokenEntity> entityOpt = JpaPushTokenRepository.super.findByPushToken(pushToken);
        return entityOpt.map(PushTokenMapper::toDomain);
    }

    List<PushToken> findByUserId(String userId) {
        List<PushTokenEntity> entities = JpaPushTokenRepository.super.findByUserId(userId);
        return entities.stream()
                .map(PushTokenMapper::toDomain)
                .toList();
    }
}