# Public URLs
# APP_BASE_URL      — this API, used in deep-link invite emails
# APP_WEB_URL       — the web app, used in invite links
# APP_FRONTEND_URL  — the web app, used for CLI login / device activation links.
#                     No locale segment: the code appends one (.../en/login?cli=...).
APP_BASE_URL=https://smartmoney-haibang.duckdns.org
APP_WEB_URL=https://smartmoney-gray.vercel.app
APP_FRONTEND_URL=https://smartmoney-gray.vercel.app

# Supabase Database Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/[PROJECT_ID]/settings/database
# Format: jdbc:postgresql://db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-database-password

# Supabase Configuration (for other services)
# Get these values from your Supabase project settings
# https://app.supabase.com/project/[PROJECT_ID]/settings/api
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Optional, only for admin operations

# Facebook OAuth Configuration
APP_FACEBOOK_APP_ID=your-facebook-app-id
APP_FACEBOOK_APP_SECRET=your-facebook-app-secret

# JWT Configuration
JWT_SECRET=your-production-secret-key
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth Configuration (if needed)
APP_GOOGLE_CLIENT_ID=your-google-client-id
APP_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary Configuration
APP_CLOUDINARY_CLOUD_NAME=your-cloud-name
APP_CLOUDINARY_API_KEY=your-api-key
APP_CLOUDINARY_API_SECRET=your-api-secret
